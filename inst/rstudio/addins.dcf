Name: Run in Mplus
Description: Run Mplus
Binding: runMplusInput
Interactive: false

Name: Run in Mplus AS JOB
Description: Run Mplus
Binding: runMplusInputAsJob
Interactive: false

Name: Set Mplus path
Description: Set path to Mplus executable command/file
Binding: setMplusPath
Interactive: true

Name: Create Mplus input
Description: Create input template and save data for Mplus
Binding: createMplusInput
Interactive: true

Name: Submit Mplus to Server
Description: Configures and submits the active Mplus input to the cluster.
Binding: submit_mplus_server
Interactive: true

Name: Setup Server
Description: Setup server defaults. Currently does not support passphrase.
Binding: setup_mplus_server
Interactive: true


